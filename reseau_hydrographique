import topotoolbox as topotoolbox
import matplotlib.pyplot as plt


#Création des profils longitudinaux
def profil_longitudinaux(nom_fichier):
    '''
    Fonction créant le profil longitudinal d'un réseau hydrographique
    

    Parameters
    ----------
    nom_fichier : str
        DESCRIPTION.

    Returns
    -------
    None.

    '''
    dem = topotoolbox.read_tif(nom_fichier) #Chargement du fichier

    fd = topotoolbox.FlowObject(dem)
    
    s = topotoolbox.StreamObject(fd,threshold=1,units='pixels')

    plt.subplots()
    
    dem.plot(cmap="terrain")
    
    s.plot(color='r')
    
    plt.figure()
    
    ax = plt.axes(xlabel="Distance (km)", ylabel="Elevation (m)")
    
    s.plotdz(dem, ax=ax, dunit='km')
    
    plt.show() 